# Infrastructure credentials. Copy to .env and change every value before
# first start. Never commit .env.

POSTGRES_USER=vulnconsole
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=vulnconsole

REDIS_PASSWORD=change-me-redis

MINIO_ROOT_USER=vulnconsole
MINIO_ROOT_PASSWORD=change-me-minio

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Application
JWT_SECRET_KEY=generate-a-long-random-value
# When set, the api container creates an 'admin' user on first start (min 12 chars)
VULNCONSOLE_SEED_ADMIN_PASSWORD=
