# Infrastructure credentials. Copy to .env and change every value before
# first start. Never commit .env.

POSTGRES_USER=vulnconsole
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=vulnconsole

REDIS_PASSWORD=change-me-redis

MINIO_ROOT_USER=vulnconsole
MINIO_ROOT_PASSWORD=change-me-minio

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Application
JWT_SECRET_KEY=generate-a-long-random-value
# When set, the api container creates an 'admin' user on first start (min 12 chars)
VULNCONSOLE_SEED_ADMIN_PASSWORD=

# Notifications (all optional). Leave blank to disable a channel; with none set,
# notifications are still recorded to the database and structured log.
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=vulnconsole@localhost
NOTIFY_EMAIL_TO=
# Base URL used in notification links back to a finding.
NOTIFICATIONS_BASE_URL=http://localhost:8080

# Branded audit report export. REPORT_LOGO_PATH is a path inside the api
# container (mount your logo to use it); without it a monogram is drawn.
REPORT_COMPANY_NAME=Your Organization
REPORT_LOGO_PATH=
REPORT_CONFIDENTIAL_LABEL=CONFIDENTIAL
