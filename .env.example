# Application-level configuration (consumed from Milestone 1 onward).
# Infrastructure credentials live in deploy/compose/.env.example.
# Copy to .env and fill in real values. Never commit .env.

# Core services
DATABASE_URL=postgresql+asyncpg://vulnconsole:change-me@localhost:5432/vulnconsole
REDIS_URL=redis://:change-me@localhost:6379/0
NATS_URL=nats://localhost:4222
OPENSEARCH_URL=http://localhost:9200
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=vulnconsole
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_ARTIFACTS=scan-artifacts

# Security
JWT_SECRET_KEY=generate-a-long-random-value
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Remediation SLA: days to remediate per severity (info has no SLA)
SLA_DAYS_CRITICAL=3
SLA_DAYS_HIGH=7
SLA_DAYS_MEDIUM=30
SLA_DAYS_LOW=90
SLA_SCAN_INTERVAL_SECONDS=60

# Notifications (all optional; unset channels are skipped, still recorded to DB)
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=vulnconsole@localhost
NOTIFY_EMAIL_TO=
NOTIFICATIONS_BASE_URL=http://localhost:8080

# Branded audit report export
REPORT_COMPANY_NAME=Your Organization
REPORT_LOGO_PATH=
REPORT_CONFIDENTIAL_LABEL=CONFIDENTIAL
REPORT_DEFAULT_DAYS=30

# Enrichment feeds (Milestone 3)
NVD_API_KEY=

# AI providers (Milestone 6)
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
